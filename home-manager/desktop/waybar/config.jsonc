{
  "layer": "top",
  "position": "top",
  "spacing": 2,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "height": 24,
  "modules-left": ["clock", "niri/window"],
  "modules-center": ["niri/workspaces"],
  "modules-right": [
    "tray",
    "cpu",
    "temperature",
    "memory",
    "disk",
    "wireplumber",
    "backlight",
    "network",
    "battery",
  ],
  /* Center Module */
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      // Named workspaces
      // (you need to configure them in niri)
      "web": "󰈹",
      "code": "⌨",
      "chat": "🗩️",

      // Icons by state
      // "active": "",
      "default": "●",
    },
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down",
  },
  /* Left Modules */
  "niri/window": {
    "format": "{title}",
    "separate-outputs": true,
    "icon": true,
    "icon-size": 20,
  },
  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage:2}%",
    "tooltip": true,
  },
  "temperature": {
    "critical-threshold": 85,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["󰔏"],
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f}G",
    "tooltip": true,
    "tooltip-format": " RAM: {used:0.2f}G / {total:0.2f}G\nSwap: {swapUsed:0.2f}G / {swapTotal:0.2f}G",
  },
  "disk": {
    "format": "󰋊 {percentage_used}%",
    "tooltip": true,
    "tooltip-format": "Disk Usage: {used} / {total} ({percentage_used}%)",
  },
  /* Right Modules */
  "tray": {
    "icon-size": 20,
    "spacing": 6,
  },
  "clock": {
    "interval": 1,
    "format": "󰥔 {:%H:%M}",
    "format-alt": "󰃭 {:%Y-%m-%d %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "network": {
    "interval": 5,
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰖪 No IP ({ifname})",
    "format-disconnected": "󰤭 Disconnected",
    "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}",
    "format-alt": "󰈀 {ipaddr}/{cidr}",
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click-right": "pwvucontrol",
  },
  "backlight": {
    "tooltip": false,
    "format": "󰃠 {}%",
    "interval": 5,
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
  },
  "battery": {
    "states": {
      "good": 70,
      "warning": 30,
      "critical": 20,
    },
    "interval": 5,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-alt": "󰢝 {power:0.2f}w/{capacity}%",
    "format-charging-alt": "󰂄 {power:0.2f}w/{capacity}%",
    "format-plugged-alt": "󰂄 {power:0.2f}w/{capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁾"],
    "actions": {
      "on-click": "mode",
    },
  },
}
